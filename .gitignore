# ═══════════════════════════════════════════════════════════════
#  .gitignore — futures_portfolio
# ═══════════════════════════════════════════════════════════════

# ── Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Bundle / vendor ───────────────────────────────────────────
node_modules/

# ── Reports (generated HTML, never commit) ─────────────────────
reports/

# ── Data artifacts (large binaries, never commit) ──────────────
data/*.feather
data/*.npz
data/*.parquet
*.npz
*.parquet
_render_*.png

# ── State files (runtime data, never commit) ─────────────────
core/*.json
!core/config.json
state.json
paper_state.json
*_state_*.json
*_shadow_*.json
archive_*.json
*.fired
*.lock

# ── Signals (runtime flags) ─────────────────────────────────
signals/
*.flag

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── History (archived states) ────────────────────────────────
history/

# ── SQLite telemetry ─────────────────────────────────────────
trading_stats.db
*.db-journal
*.db-wal
*.db-shm

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.nox/
.tox/
.hypothesis/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── MyPy ─────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Temporary files ──────────────────────────────────────────
*.tmp
*.bak
*.orig
nul
scan_cache.json
scripts/query_counts.py
experiments/