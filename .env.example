# ═══════════════════════════════════════════════════════════════
#  .env.example — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════════

# ── Binance API ──────────────────────────────────────────────
# Required for live trading. Get keys from:
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# ── Telegram Notifications ───────────────────────────────────
# Required for bot status notifications.
# Create a bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: custom Telegram API endpoint (for proxies)
# TELEGRAM_API_BASE=https://api.telegram.org

# ── Testing ──────────────────────────────────────────────────
# Set to 1 to enable mock mode (no real API calls)
# MOCK_MODE=1
